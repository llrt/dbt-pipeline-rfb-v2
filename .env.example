# Configuração do pipeline. Copie para .env e edite; sem valores secretos no repo.
# Variável vazia equivale a ausente (usa o padrão). Tudo abaixo é opcional no modo local.

# Onde ficam raw/, gold/ e os manifestos. Padrão: ./data. Aceita s3://bucket/prefixo (ver abaixo).
# RAIZ_DADOS=./data

# Limiares da ingestão
# RFB_MAX_TAXA_REJEITO=0.0001
# RFB_VELOCIDADE_MINIMA_BPS=51200
# RFB_JANELA_LENTIDAO_S=60
# RFB_MAX_RETOMADAS=50
# RFB_TEMPO_LIMITE_TOTAL_S=3600

# DuckDB
# DUCKDB_MEMORY_LIMIT=8GB
# DUCKDB_THREADS=4

# --- Modo S3/Tigris (ADR-0007) -------------------------------------------------------------
# Fluxo: `rfb ingerir` (grava local em RAIZ_DADOS_LOCAL) -> `rfb sincronizar` (envia raw/ e gold/) ->
# `dbt build --target s3` (lê s3://; o arquivo .duckdb e os temporários ficam locais).
# RAIZ_DADOS=s3://meu-bucket/prefixo
# RAIZ_DADOS_LOCAL=./data
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_ENDPOINT_URL_S3=https://fly.storage.tigris.dev
# S3_URL_STYLE=vhost
